generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Student {
  id          String        @id @default(cuid())
  rollNumber  String        @unique
  name        String
  hostel      String
  dietPref    String        @default("Veg") // Veg, Non-Veg, Jain
  streak      Int           @default(0) // consecutive off-peak streak
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  bookings    SlotBooking[]
}

model Mess {
  id              String        @id @default(cuid())
  code            String        @unique // e.g. "mess-1", "mess-2"
  name            String
  capacity        Int           @default(200)
  servingLines    Int           @default(1)
  queueLowThresh  Int           @default(15)
  queueHighThresh Int           @default(35)
  active          Boolean       @default(true)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  bookings        SlotBooking[]
  queueEvents     QueueEvent[]
  wasteLogs       WasteLog[]
  forecasts       Forecast[]
  eventFlags      EventFlag[]
}

model MenuItem {
  id               String     @id @default(cuid())
  name             String
  category         String     // Main, Curry, Bread, Sweet, Side
  avgConsumptionKg Float      // average consumption per plate in kg
  unitCostInr      Float      // price per kg
  isPopular        Boolean    @default(false)
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  wasteLogs        WasteLog[]
}

model SlotBooking {
  id          String   @id @default(cuid())
  studentId   String
  student     Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  messId      String
  mess        Mess     @relation(fields: [messId], references: [id], onDelete: Cascade)
  date        String   // YYYY-MM-DD
  mealType    String   // Lunch, Dinner
  slotStart   String   // e.g. "12:30"
  slotEnd     String   // e.g. "12:45"
  portion     String   @default("Regular") // Small, Regular, Large
  dietType    String   @default("Veg")
  status      String   @default("BOOKED") // BOOKED, ARRIVED, NO_SHOW, SKIPPED
  checkinCode String   // 4-digit code e.g. "4819"
  isOffPeak   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([studentId, date, mealType])
  @@index([messId, date, mealType, slotStart])
}

model QueueEvent {
  id              String   @id @default(cuid())
  messId          String
  mess            Mess     @relation(fields: [messId], references: [id], onDelete: Cascade)
  date            String
  mealType        String
  eventType       String   // "CHECKIN", "WALKIN", "SERVED", "DRIFT_ADJUST"
  studentRoll     String?
  adjustmentValue Int      @default(1)
  createdAt       DateTime @default(now())

  @@index([messId, createdAt])
}

model WasteLog {
  id               String   @id @default(cuid())
  messId           String
  mess             Mess     @relation(fields: [messId], references: [id], onDelete: Cascade)
  menuItemId       String
  menuItem         MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  date             String
  mealType         String
  cookedKg         Float
  leftoverCookedKg Float
  plateWasteKg     Float    @default(0)
  createdAt        DateTime @default(now())

  @@index([menuItemId, date])
  @@index([messId, date, mealType])
}

model Forecast {
  id                 String   @id @default(cuid())
  messId             String
  mess               Mess     @relation(fields: [messId], references: [id], onDelete: Cascade)
  date               String
  mealType           String
  historicalAvg      Int
  bookedCount        Int
  expectedPlates     Int
  actualPlates       Int?
  confidenceLevel    String   // "Low", "Moderate", "High"
  confidenceNote     String
  safetyBufferPct    Float    @default(8.0)
  surplusNgoNotified Boolean  @default(false)
  surplusNgoContact  String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@unique([messId, date, mealType])
}

model EventFlag {
  id            String   @id @default(cuid())
  messId        String
  mess          Mess     @relation(fields: [messId], references: [id], onDelete: Cascade)
  date          String
  mealType      String
  title         String   // "Exam Day", "Fest", "Weekend", "Holiday"
  adjustmentPct Float    @default(0)
  createdAt     DateTime @default(now())

  @@unique([messId, date, mealType])
}

model Setting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}
